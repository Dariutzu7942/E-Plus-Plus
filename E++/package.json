{
  "name": "eplusplus-language",
  "version": "0.4.0",
  "description": "The standalone E++ programming language runtime",
  "license": "MIT",
  "type": "module",
  "bin": {
    "e++": "bin/epp.js",
    "epp": "bin/epp.js"
  },
  "files": [
    "bin/",
    "src/",
    "CMakeLists.txt",
    "README.md"
  ],
  "scripts": {
    "build": "cmake -S . -B build && cmake --build build",
    "test": "npm run build && ctest --test-dir build --output-on-failure",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["language", "interpreter", "compiler", "runtime", "epp"]
}
